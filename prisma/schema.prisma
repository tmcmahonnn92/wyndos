// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// --- Multi-Tenancy -----------------------------------------------------------

/// A single window-cleaning business (one per OWNER sign-up).
model Tenant {
  id        Int      @id @default(autoincrement())
  name      String                       // company / trading name
  slug      String   @unique             // url-safe identifier, also used in URLs
  phone     String   @default("")
  address   String   @default("")
  website   String   @default("")
  logoUrl   String   @default("")
  /// What they told us at sign-up (customer count, team size, payment methods, how they found us). JSON.
  signupInfo String  @default("{}")
  /// Billing. Free trial runs to trialEndsAt (or 15 days from createdAt when empty).
  trialEndsAt          DateTime?
  /// Never asked to pay (early users, Tom's own businesses).
  billingExempt        Boolean   @default(false)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  /// Stripe subscription status: trialing, active, past_due, canceled, unpaid, incomplete…
  subscriptionStatus   String    @default("")
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  /// Terms + privacy accepted by the owner (version string from src/lib/legal.ts).
  termsVersion         String    @default("")
  termsAcceptedAt      DateTime?
  termsAcceptedByUserId String?
  /// Owner confirmed they have the right to store and use their customers' details to provide their service.
  dataPermissionAcceptedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  memberships Membership[]
  areas     Area[]
  customers Customer[]
  workDays  WorkDay[]
  expenses  Expense[]
  otherIncomeEntries OtherIncome[]
  vehicles  Vehicle[]
  mileageTrips MileageTrip[]
  homeUseMonths HomeUseMonth[]
  businessAssets BusinessAsset[]
  mtdQuarterLocks MtdQuarterLock[]
  tags      Tag[]
  holidays  Holiday[]
  invites   Invite[]
  settings  TenantSettings?
  supportAccessLogs SupportAccessLog[]
  messageLogs MessageLog[]
}

/// Per-tenant app configuration (SMTP, SMS, invoice, templates).
/// One row per Tenant; created during onboarding.
model TenantSettings {
  id              Int    @id @default(autoincrement())
  tenantId        Int    @unique
  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Branding / invoice
  businessName    String @default("My Window Cleaning")
  ownerName       String @default("")
  phone           String @default("")
  email           String @default("")
  address         String @default("")
  bankDetails     String @default("")
  vatNumber       String @default("")
  invoicePrefix   String @default("INV")
  nextInvoiceNum  Int    @default(1)
  /// Set once the first invoice number is used; the start number can no longer change.
  invoiceNumbersStarted Boolean @default(false)
  /// Show VAT on invoices (needs a VAT number). Prices are treated as including VAT.
  invoiceVatEnabled Boolean @default(false)
  invoiceVatRate    Float   @default(20)
  /// Keep money paid in advance or paid extra as credit for the next cleans.
  allowCustomerCredit Boolean @default(true)
  /// When an area's run is finished, give its next run to the same worker. Off: next run is unassigned.
  keepWorkerOnNextRun Boolean @default(true)
  /// Payment terms / how to pay, printed on every invoice.
  invoicePaymentTerms String @default("")
  logoBase64      String? // base64 data URL
  goCardlessAccessToken     String   @default("")
  goCardlessEnvironment     String   @default("live")
  goCardlessReferencePrefix String   @default("WD")
  goCardlessLastSyncedAt    DateTime?
  /// Business name on the connected GoCardless account (shown in Settings).
  goCardlessCreditorName    String   @default("")
  /// Collect by Direct Debit automatically when a clean is completed (only cleans completed after this was turned on).
  goCardlessAutoCollect     Boolean  @default(false)
  goCardlessAutoCollectFrom DateTime?
  goCardlessLastError       String   @default("")
  /// Accounts: CASH (money in/out when paid; default for sole traders) or ACCRUALS (income when the clean is done).
  accountingBasis           String   @default("CASH")
  /// MTD quarterly periods: STANDARD (6 Apr–5 Jul…) or CALENDAR (1 Apr–30 Jun…).
  mtdPeriodType             String   @default("STANDARD")

  // SMTP
  smtpProvider    String @default("gmail")
  smtpHost        String @default("")
  smtpPort        Int    @default(587)
  smtpUser        String @default("")
  smtpPass        String @default("")
  smtpFromName    String @default("")

  // SMS / messaging
  messagingProvider    String @default("voodoosms")
  voodooApiKey         String @default("")
  voodooSender         String @default("VoodooSMS")
  twilioAccountSid     String @default("")
  twilioAuthToken      String @default("")
  twilioFromNumber     String @default("")
  metaPhoneNumberId    String @default("")
  metaAccessToken      String @default("")
  metaWabaId           String @default("")

  // Message templates
  tmplCleaningReminder  String @default("Hi {{customerFirstName}}, just a reminder your window cleaning is scheduled for {{jobDate}}. Thanks, {{businessName}}")
  tmplJobComplete       String @default("Hi {{customerFirstName}}, your window cleaning has been completed today. Thanks for your custom! {{businessName}}")
  tmplPaymentReminder1  String @default("Hi {{customerFirstName}}, just a friendly reminder you have an outstanding balance of {{amountDue}} for window cleaning. Please arrange payment at your convenience. Thanks, {{businessName}}")
  tmplPaymentReminder2  String @default("Hi {{customerFirstName}}, this is a second reminder - your window cleaning balance of {{amountDue}} is overdue. Please arrange payment as soon as possible. Thanks, {{businessName}}")
  tmplPaymentReminder3  String @default("Hi {{customerFirstName}}, this is a final reminder regarding your outstanding balance of {{amountDue}}. Please contact us immediately. {{businessName}}")
  tmplPaymentReceived   String @default("Hi {{customerFirstName}}, we have received your payment of {{amountDue}}. Thank you! {{businessName}}")
  tmplJobAndPayment     String @default("Hi {{customerFirstName}}, your window cleaning is complete and you have an outstanding balance of {{amountDue}}. Please arrange payment at your convenience. Thanks, {{businessName}}")
  tmplInvoiceNote       String @default("")
  tmplCleanedBank       String @default("Hi {{customerFirstName}}, your windows at {{customerAddress}} have been cleaned today. {{amountDue}} is due. To pay by bank: {{bankDetails}}. Please use {{paymentReference}} as the reference. Thanks, {{businessName}}")

  // Automatic texts. Test mode logs every text instead of sending it.
  /// PHONE: each text opens in the user's own Messages app (one tap each). VOODOO: sent by the server.
  textSendMethod           String  @default("PHONE")
  textsTestMode            Boolean @default(true)
  textCleanedEnabled       Boolean @default(false)
  textSkipCleanedIfPaid    Boolean @default(true)
  textPaymentReminderDays  Int     @default(0)
  textPaymentReminder2Days Int     @default(0)
  /// A run includes customers due up to this many days after its date (so the area stays
  /// together). Null = half the area's frequency, e.g. 14 days for 4-weekly.
  runDueWindowDays         Int?
}

/// Pending invite for a worker to join a tenant's account.
model Invite {
  id         Int       @id @default(autoincrement())
  token      String    @unique @default(cuid())
  email      String
  role       UserRole  @default(WORKER)
  /// JSON array of Permission strings to grant to the worker when they accept the invite.
  permissions String   @default("[\"schedule\"]")
  tenantId   Int
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@index([tenantId, email])
}

// --- Auth --------------------------------------------------------------------

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  /// SUPER_ADMIN has tenantId = null; OWNER and WORKER have tenantId set.
  role               UserRole  @default(OWNER)
  tenantId           Int?
  tenant             Tenant?   @relation(fields: [tenantId], references: [id])
  onboardingComplete Boolean   @default(false)
  /// JSON array of Permission strings â€” only used for WORKER accounts. OWNER/SUPER_ADMIN always have full access.
  workerPermissions  String    @default("[]")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  accounts           Account[]
  sessions           Session[]
  memberships        Membership[]
  assignedWorkDays   WorkDay[] @relation("AssignedWorkerWorkDays")
  /// Jobs assigned to this user individually (overrides the work day's worker).
  assignedJobs       Job[]     @relation("AssignedWorkerJobs")
  /// Jobs this user marked complete.
  completedJobs      Job[]     @relation("CompletedByJobs")
  supportAccessLogs  SupportAccessLog[] @relation("SupportAdminLogs")
  endedSupportAccessLogs SupportAccessLog[] @relation("EndedSupportAccessLogs")

  @@index([tenantId])
}

model Membership {
  id          Int       @id @default(autoincrement())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role        UserRole  @default(WORKER)
  permissions String    @default("[]")
  /// JSON: which email notifications this person wants in this business.
  notifyPrefs String    @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([tenantId, role])
  @@index([userId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique @default(cuid())
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// --- Support Access & Audit --------------------------------------------------

model SupportAccessLog {
  id               Int      @id @default(autoincrement())
  tenantId         Int
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  superAdminUserId String
  superAdminUser   User     @relation("SupportAdminLogs", fields: [superAdminUserId], references: [id], onDelete: Cascade)
  endedByUserId    String?
  endedByUser      User?    @relation("EndedSupportAccessLogs", fields: [endedByUserId], references: [id], onDelete: SetNull)
  reason           String
  scope            String   @default("SUPPORT_VIEW")
  ipAddress        String   @default("")
  userAgent        String   @default("")
  createdAt        DateTime @default(now())
  endedAt          DateTime?

  @@index([tenantId])
  @@index([superAdminUserId])
  @@index([createdAt])
  @@index([endedAt])
}

// --- Business Data (all scoped to a Tenant) ---------------------------------

model Area {
  id                Int        @id @default(autoincrement())
  tenantId          Int
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  color             String     @default("#3B82F6")
  sortOrder         Int        @default(0)
  // WEEKLY: runs every frequencyWeeks weeks
  // MONTHLY: runs on monthlyDay of each calendar month (1-28)
  scheduleType      String     @default("WEEKLY")
  frequencyWeeks    Int        @default(4)
  monthlyDay        Int?
  nextDueDate       DateTime?
  lastCompletedDate DateTime?
  isSystemArea      Boolean    @default(false)
  /// This area's own "include customers due up to N days after the run". Null = business setting.
  dueWindowDays     Int?
  customers         Customer[]
  workDays          WorkDay[]
  createdAt         DateTime   @default(now())

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, nextDueDate])
}

model Tag {
  id        Int           @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  color     String        @default("#6B7280")
  createdAt DateTime      @default(now())
  customers CustomerTag[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model CustomerTag {
  customerId Int
  tagId      Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
}

model Customer {
  id                     Int           @id @default(autoincrement())
  tenantId               Int
  tenant                 Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                   String
  /// Display line, always composed from the parts below (when they are set).
  address                String
  houseNameNumber        String        @default("")
  street                 String        @default("")
  town                   String        @default("")
  postcode               String        @default("")
  email                  String        @default("")
  phone                  String        @default("")
  areaId                 Int
  area                   Area          @relation(fields: [areaId], references: [id])
  frequencyWeeks         Int           @default(4)
  price                  Float
  notes                  String?
  jobName                String        @default("Window Cleaning")
  advanceNotice          Boolean       @default(false)
  preferredPaymentMethod String        @default("")
  goCardlessCustomerReference String   @default("")
  goCardlessCustomerId    String?
  goCardlessMandateId     String?
  /// Last known mandate status from GoCardless (active, cancelled, …).
  goCardlessMandateStatus String?
  /// A sign-up link sent to the customer that hasn't been completed yet.
  goCardlessBillingRequestId String?
  active                 Boolean       @default(true)
  sortOrder              Int           @default(0)
  /// Always put this customer straight after that customer when both are on the same day (any area).
  placeAfterCustomerId   Int?
  nextDueDate            DateTime?
  lastCompletedDate      DateTime?
  skipNextAreaRun        Boolean       @default(false)
  /// Leave a slip (calling card) after the clean.
  slip                   Boolean       @default(true)
  /// A quote lead, not a live customer yet: never scheduled until marked live.
  isProspect             Boolean       @default(false)
  /// Another customer who pays this customer's bills (e.g. a neighbour).
  paidByCustomerId       Int?
  paidBy                 Customer?     @relation("PaidBy", fields: [paidByCustomerId], references: [id], onDelete: SetNull)
  paysFor                Customer[]    @relation("PaidBy")
  /// Map pin set by hand. When set, maps and routes use these instead of the address.
  latitude               Float?
  longitude              Float?
  createdAt              DateTime      @default(now())
  jobs                   Job[]
  payments               Payment[]
  bankReferences         PayerReference[]
  tags                   CustomerTag[]

  @@index([tenantId])
  @@index([tenantId, areaId])
  @@index([tenantId, active])
  @@index([tenantId, goCardlessCustomerReference])
  @@index([tenantId, nextDueDate])
}

model WorkDay {
  id        Int           @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date      DateTime
  /// Position of this area among the areas on its date (null = the areas' normal order).
  dayOrder        Int?
  areaId    Int?
  area      Area?         @relation(fields: [areaId], references: [id])
  assignedUserId String?
  assignedUser   User?    @relation("AssignedWorkerWorkDays", fields: [assignedUserId], references: [id], onDelete: SetNull)
  status    WorkDayStatus @default(PLANNED)
  routeOrderingMode String @default("MANUAL")
  manualRouteOrder  String?
  optimizedRouteOrder String?
  notes     String?
  /// Set on a "part" of an area's run that was split onto another date: the id of the
  /// run's main day. The area's next run is only booked once every part is done.
  partOfId  Int?
  createdAt DateTime      @default(now())
  jobs      Job[]

  @@unique([tenantId, date, areaId])
  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, areaId])
  @@index([tenantId, assignedUserId])
  @@index([partOfId])
}

model Job {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  workDayId   Int
  workDay     WorkDay   @relation(fields: [workDayId], references: [id])
  customerId  Int
  customer    Customer  @relation(fields: [customerId], references: [id])
  name        String    @default("Window Cleaning")
  status      JobStatus @default(PENDING)
  price       Float
  completedAt DateTime?
  /// When the clean went on an invoice, and its number ("" when marked by hand).
  invoicedAt    DateTime?
  invoiceNumber String    @default("")
  notes       String?
  sortOrder   Int       @default(0)
  /// Where this job goes on its date, today only: after that job (any area), 0 = first, -1 = stay in its own area. Null = normal order.
  afterJobId  Int?
  isOneOff    Boolean   @default(false)
  /// A quote visit rather than a clean. Price stays 0; the quote is in quotedPrice.
  isQuote              Boolean   @default(false)
  /// Direct Debit taken for this clean through GoCardless, and its latest status.
  goCardlessPaymentId  String?   @unique
  goCardlessStatus     String?
  /// TO_VISIT | QUOTED | WON | LOST
  quoteStatus          String?
  quotedPrice          Float?
  quotedFrequencyWeeks Int?
  quotedAt             DateTime?
  /// Worker for this job. Null = follow the work day's assigned worker.
  assignedUserId    String?
  assignedUser      User?     @relation("AssignedWorkerJobs", fields: [assignedUserId], references: [id], onDelete: SetNull)
  /// Who marked the job complete (used for worker pay reports).
  completedByUserId String?
  completedBy       User?     @relation("CompletedByJobs", fields: [completedByUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  allocations PaymentAllocation[]

  @@index([tenantId])
  @@index([tenantId, workDayId])
  @@index([tenantId, customerId])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, completedByUserId])
  @@index([tenantId, isQuote, quoteStatus])
  @@index([tenantId, status])
  @@index([completedAt])
}

model Payment {
  id          Int                 @id @default(autoincrement())
  tenantId    Int
  customerId  Int
  customer    Customer            @relation(fields: [customerId], references: [id])
  amount      Float
  method      PaymentMethod       @default(CASH)
  paidAt      DateTime            @default(now())
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  voidedAt    DateTime?
  voidReason  String?
  goCardlessPaymentId String?     @unique
  goCardlessStatus    String?
  goCardlessReference String?
  /// User who recorded / collected the payment.
  collectedByUserId   String?
  /// Client-generated id so an offline retry can't record the same payment twice.
  clientRequestId     String?             @unique
  /// Cash a team member took, once they've handed it to the owner.
  handoverId          Int?
  handover            CashHandover?       @relation(fields: [handoverId], references: [id], onDelete: SetNull)
  allocations PaymentAllocation[]

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, goCardlessStatus])
  @@index([paidAt])
  @@index([voidedAt])
}

model Expense {
  id              Int       @id @default(autoincrement())
  tenantId        Int
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recurrenceTemplateId Int?
  category        String    @default("OTHER")
  hmrcCategory    String    @default("OTHER")
  /// Share that's for the business; the rest goes in HMRC's "disallowable" box (e.g. van 80%).
  businessPct     Int       @default(100)
  vehicleId       Int?
  supplier        String    @default("")
  amount          Float
  netAmount       Float     @default(0)
  vatAmount       Float     @default(0)
  vatRate         Float     @default(0)
  taxTreatment    String    @default("NO_VAT")
  expenseDate     DateTime  @default(now())
  notes           String?
  isRecurring     Boolean   @default(false)
  repeatEvery     Int?
  repeatUnit      String?
  repeatAnchorDate DateTime?
  nextScheduledAt DateTime?
  repeatEndsAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId])
  @@index([tenantId, expenseDate])
  @@index([tenantId, category])
  @@index([tenantId, recurrenceTemplateId])
}

model OtherIncome {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recurrenceTemplateId Int?
  category    String    @default("OTHER")
  source      String    @default("")
  amount      Float
  netAmount   Float     @default(0)
  vatAmount   Float     @default(0)
  vatRate     Float     @default(0)
  taxTreatment String   @default("NO_VAT")
  receivedAt  DateTime  @default(now())
  notes       String?
  isRecurring Boolean   @default(false)
  repeatEvery Int?
  repeatUnit  String?
  repeatAnchorDate DateTime?
  nextScheduledAt DateTime?
  repeatEndsAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([tenantId, receivedAt])
  @@index([tenantId, category])
  @@index([tenantId, recurrenceTemplateId])
}

model PaymentAllocation {
  id        Int     @id @default(autoincrement())
  tenantId  Int
  paymentId Int
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  jobId     Int
  job       Job     @relation(fields: [jobId], references: [id])
  amount    Float

  @@index([tenantId])
  @@index([paymentId])
  @@index([jobId])
}

model Holiday {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  label     String   @default("Holiday")
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, startDate])
  @@index([tenantId, endDate])
}

// --- Enums -------------------------------------------------------------------

enum UserRole {
  /// Application super-admin ï¿½ no tenant, can view any tenant's data.
  SUPER_ADMIN
  /// Window cleaning business owner ï¿½ created when they sign up.
  OWNER
  /// Worker/employee invited by an OWNER to access their round.
  WORKER
}

enum WorkDayStatus {
  PLANNED
  IN_PROGRESS
  COMPLETE
}

enum JobStatus {
  PENDING
  COMPLETE
  SKIPPED
  MOVED
  OUTSTANDING
}

enum PaymentMethod {
  CASH
  BACS
  CARD
}


/// Every text the app sends (or, in test mode, would have sent).
model MessageLog {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId   Int?
  jobId        Int?
  workDayId    Int?
  /// DAY_REMINDER, CLEANED, PAYMENT_REMINDER_1, PAYMENT_REMINDER_2, BULK
  kind         String
  toNumber     String
  body         String
  /// TEST (not sent), SENT, FAILED, TO_SEND (waiting to go from a phone), PHONE (opened on a phone to send)
  status       String
  error        String   @default("")
  sentByUserId String?
  /// Cleared from the log by the user. Kept so reminders / cleaned texts aren't sent twice.
  clearedAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, kind, customerId])
  @@index([tenantId, status])
}


/// An email notification waiting to go out. Held for a minute, then re-checked
/// (a day started and straight away undone sends nothing).
model NotificationEvent {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  /// DAY_STARTED, DAY_COMPLETED, WORK_ASSIGNED
  kind        String
  workDayId   Int?
  /// WORK_ASSIGNED: who the work was given to
  userId      String?
  /// WORK_ASSIGNED: JSON list of job ids
  jobIds      String    @default("[]")
  actorUserId String?
  dueAt       DateTime
  sentAt      DateTime?
  skipped     String?
  createdAt   DateTime  @default(now())

  @@index([sentAt, dueAt])
  @@index([tenantId])
}

// --- Support tickets ----------------------------------------------------------

/// A message sent from the in-app support form. Replies are emailed from the support address.
model SupportTicket {
  id         Int       @id @default(autoincrement())
  tenantId   Int?
  userId     String?
  fromName   String    @default("")
  fromEmail  String    @default("")
  copyTo     String    @default("")
  kind       String    @default("")
  section    String    @default("")
  subject    String
  message    String
  page       String    @default("")
  browser    String    @default("")
  /// File names only (the files themselves went by email).
  files      String    @default("")
  /// OPEN | CLOSED
  status     String    @default("OPEN")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  closedAt   DateTime?
  replies    SupportReply[]

  @@index([status, createdAt])
  @@index([tenantId])
}

model SupportReply {
  id        Int           @id @default(autoincrement())
  ticketId  Int
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// Who wrote it in the admin console.
  authorId  String?
  body      String
  /// ADMIN (sent from Wyndos) | NOTE (internal, not emailed)
  kind      String        @default("ADMIN")
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

/// Cash a team member gave to the owner (covers the payments that point at it).
model CashHandover {
  id               Int       @id @default(autoincrement())
  tenantId         Int
  workerUserId     String
  receivedByUserId String
  amount           Float
  notes            String    @default("")
  createdAt        DateTime  @default(now())
  payments         Payment[]

  @@index([tenantId, workerUserId])
}

/// One bank statement / spreadsheet import. The file itself is never uploaded or kept:
/// it is read in the browser and only the rows the user confirmed are sent.
model PaymentImport {
  id              Int            @id @default(autoincrement())
  tenantId        Int
  createdByUserId String?
  createdAt       DateTime       @default(now())
  undoneAt        DateTime?
  paidCount       Int            @default(0)
  ignoredCount    Int            @default(0)
  total           Float          @default(0)
  lines           ImportedLine[]

  @@index([tenantId])
}

/// A statement line already dealt with (paid or ignored), so overlapping statements skip it.
/// Only a one-way hash of the line is kept, never the line itself.
model ImportedLine {
  id        Int           @id @default(autoincrement())
  tenantId  Int
  importId  Int
  import    PaymentImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  hash      String
  paymentId Int?
  ignored   Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@unique([tenantId, hash])
  @@index([importId])
}

/// A bank reference / payer name learned from a confirmed match. Only ever a suggestion:
/// every import row is still checked by the user before it is saved.
model PayerReference {
  id         Int       @id @default(autoincrement())
  tenantId   Int
  /// Normalised: upper case, letters and digits only.
  key        String
  /// As it appeared on the statement (trimmed, max 60 characters).
  label      String
  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// "Not a customer payment": rows with this reference are suggested as Ignore.
  ignore     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())

  @@unique([tenantId, key])
  @@index([tenantId, customerId])
}

/// A vehicle used in the business (MTD: mileage at flat rates, or actual costs with a private-use split).
model Vehicle {
  id             Int       @id @default(autoincrement())
  tenantId       Int
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  registration   String    @default("")
  /// CAR | VAN | MOTORCYCLE
  kind           String    @default("VAN")
  /// MILEAGE (simplified flat rate per mile) | ACTUAL (real costs × business use %)
  method         String    @default("ACTUAL")
  businessPct    Int       @default(100)
  archived       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  trips          MileageTrip[]
  @@index([tenantId])
}

/// Business miles for a vehicle on the mileage method (one line per trip, day or month).
model MileageTrip {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicleId  Int
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date       DateTime
  miles      Float
  notes      String?
  createdAt  DateTime @default(now())
  @@index([tenantId, date])
}

/// Working from home: hours in a month, claimed at HMRC's flat monthly rate.
model HomeUseMonth {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// First day of the month.
  month      DateTime
  hours      Int
  @@unique([tenantId, month])
}

/// Something bought to keep (van, ladders, water-fed kit): capital allowances, or an expense on the cash basis.
model BusinessAsset {
  id            Int       @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  description   String
  boughtAt      DateTime
  cost          Float
  /// EQUIPMENT | VAN | CAR
  kind          String    @default("EQUIPMENT")
  /// Cars only: ZERO (electric) | LOW (≤50g/km CO2) | HIGH (>50g/km)
  carEmissions  String?
  businessPct   Int       @default(100)
  disposedAt    DateTime?
  disposalValue Float?
  notes         String?
  createdAt     DateTime  @default(now())
  @@index([tenantId])
}

/// A quarterly update marked as submitted to HMRC: entries in it can't change, and the figures sent are kept.
model MtdQuarterLock {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  /// The cumulative figures as they were when locked (JSON).
  snapshot    String
  lockedAt    DateTime @default(now())
  @@unique([tenantId, periodStart])
}
