[Unit]
Description=Wyndos STAGING (test copy)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=wyndos
Group=wyndos
WorkingDirectory=/opt/wyndos-staging/current
EnvironmentFile=/opt/wyndos-staging/shared/.env.production
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3001
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
StandardOutput=append:/var/log/wyndos-staging/app.log
StandardError=append:/var/log/wyndos-staging/app-error.log

[Install]
WantedBy=multi-user.target
